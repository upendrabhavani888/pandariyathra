# Copy to /etc/pandari-yathra.env and fill in. Keep it private:  sudo chown root:pandari /etc/pandari-yathra.env && sudo chmod 640 /etc/pandari-yathra.env
PORT=4000
DATA_DIR=/var/lib/pandari-yathra

# Two long random secrets. Make each with:  openssl rand -hex 32
# ID_ENC_KEY encrypts Govt ID numbers. If you lose it, stored IDs cannot be read again, so keep a copy somewhere safe, apart from the server.
ID_ENC_KEY=
JWT_SECRET=

# Optional: lets the server read tickets with Claude (photos and unusual PDF layouts). The key stays on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Number of web servers in front of this app (Caddy or nginx = 1; with Cloudflare in front as well = 2).
TRUST_PROXY=1
# Hours a sign-in lasts, and how many nightly database copies to keep.
TOKEN_HOURS=12
BACKUP_KEEP=14
